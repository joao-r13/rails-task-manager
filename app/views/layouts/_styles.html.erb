<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
<link rel="stylesheet" href="https://use.fontawesome.com/releases/v6.1.2/css/all.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" defer></script>

<style>
  :root {
    --accent: #6366f1;
    --accent-dark: #4f46e5;
    --ink: #1e293b;
    --muted: #64748b;
    --line: #e2e8f0;
  }

  body {
    font-family: "Inter", system-ui, -apple-system, sans-serif;
    color: var(--ink);
    background: linear-gradient(160deg, #eef2ff 0%, #f8fafc 45%, #fdf2f8 100%);
    min-height: 100vh;
  }

  .app-shell { max-width: 760px; margin: 0 auto; padding: 3rem 1.25rem 4rem; }
  .page-title { font-weight: 700; letter-spacing: -0.02em; }

  /* Buttons */
  .btn { border-radius: 999px; font-weight: 600; padding: .6rem 1.4rem; transition: all .18s ease; }
  .btn-sm { padding: .4rem 1rem; }
  .btn-accent { background: var(--accent); border-color: var(--accent); color: #fff; box-shadow: 0 6px 16px rgba(99,102,241,.3); }
  .btn-accent:hover, .btn-accent:focus { background: var(--accent-dark); border-color: var(--accent-dark); color: #fff; transform: translateY(-1px); }
  .btn-soft { background: #fff; border: 1px solid var(--line); color: var(--muted); }
  .btn-soft:hover { background: #f1f5f9; color: var(--ink); }
  .btn-icon { width: 40px; height: 40px; padding: 0; display: inline-flex; align-items: center; justify-content: center; }
  .btn-icon.edit:hover { background: #eef2ff; color: var(--accent); border-color: #c7d2fe; }
  .btn-icon.delete:hover { background: #fef2f2; color: #dc2626; border-color: #fecaca; }

  /* Task cards */
  .task-card { border-radius: 1.1rem; background: #fff; box-shadow: 0 2px 10px rgba(15,23,42,.05); transition: transform .18s ease, box-shadow .18s ease; }
  .task-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(15,23,42,.10); }
  .task-title { font-weight: 600; font-size: 1.05rem; color: var(--ink); text-decoration: none; }
  .task-title:hover { color: var(--accent); }
  .task-card.is-done .task-title { text-decoration: line-through; color: var(--muted); }
  .status-icon { width: 44px; height: 44px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: #f1f5f9; color: var(--muted); flex-shrink: 0; font-size: 1.1rem; }
  .task-card.is-done .status-icon { background: #dcfce7; color: #16a34a; }
  .min-w-0 { min-width: 0; }

  /* Panels (show / new / edit) */
  .panel-card { border: 0; border-radius: 1.25rem; background: #fff; box-shadow: 0 10px 40px rgba(15,23,42,.08); }
  .panel-card .panel-body { padding: 2.25rem; }
  .panel-card .panel-footer { padding: 1.25rem 2.25rem; border-top: 1px solid var(--line); background: #fafbfd; border-radius: 0 0 1.25rem 1.25rem; }

  /* Inputs */
  .form-label { font-weight: 600; font-size: .9rem; margin-bottom: .5rem; }
  .form-control { border: 1.5px solid var(--line); border-radius: .85rem; padding: .85rem 1.1rem; background: #f8fafc; transition: all .15s ease; }
  .form-control::placeholder { color: #94a3b8; }
  .form-control:focus { background: #fff; border-color: var(--accent); box-shadow: 0 0 0 .25rem rgba(99,102,241,.15); }

  /* Toggle button replacing the checkbox */
  .toggle-status { width: 100%; padding: 1rem 1.25rem; border-radius: .85rem; border: 1.5px solid var(--line); background: #f8fafc; color: var(--muted); text-align: left; display: flex; align-items: center; justify-content: space-between; }
  .toggle-status:hover { border-color: #cbd5e1; }
  .toggle-status .when-on { display: none; }
  .btn-check:checked + .toggle-status { background: #dcfce7; border-color: #86efac; color: #15803d; }
  .btn-check:checked + .toggle-status .when-on { display: inline; }
  .btn-check:checked + .toggle-status .when-off { display: none; }
  .btn-check:focus-visible + .toggle-status { box-shadow: 0 0 0 .25rem rgba(99,102,241,.2); }

  .empty-state { text-align: center; padding: 4rem 1rem; color: var(--muted); }
  .empty-state i { font-size: 2.5rem; color: #c7d2fe; margin-bottom: 1rem; }
</style>

<script>
  function initTooltips() {
    if (!window.bootstrap) return;
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
      bootstrap.Tooltip.getOrCreateInstance(el);
    });
  }
  document.addEventListener("turbo:load", initTooltips);
  window.addEventListener("load", initTooltips);
</script>
