<div class="app-shell">
  <div class="d-flex justify-content-between align-items-end mb-4">
    <div>
      <h1 class="page-title h2 mb-1">My Tasks</h1>
      <p class="text-muted mb-0">
        <%= @tasks.where(completed: true).count %> of <%= @tasks.count %> completed
      </p>
    </div>
    <%= link_to new_task_path, class: "btn btn-accent" do %>
      <i class="fa-solid fa-plus me-2"></i>New task
    <% end %>
  </div>

  <% if @tasks.any? %>
    <% @tasks.each do |task| %>
      <div class="task-card card border-0 mb-3 <%= 'is-done' if task.completed %>">
        <div class="card-body d-flex align-items-center gap-3 p-4">
          <span class="status-icon">
            <i class="<%= task.completed ? 'fa-solid fa-check' : 'fa-regular fa-clock' %>"></i>
          </span>

          <div class="flex-grow-1 min-w-0">
            <%= link_to task.title, task_path(task), class: "task-title d-block text-truncate" %>
            <% if task.details.present? %>
              <p class="text-muted small mb-0 mt-1 text-truncate"><%= task.details %></p>
            <% end %>
          </div>

          <div class="d-flex gap-2">
            <%= link_to edit_task_path(task), class: "btn btn-soft btn-icon edit",
                  title: "Edit", data: { bs_toggle: "tooltip" } do %>
              <i class="fa-solid fa-pen"></i>
            <% end %>
            <%= button_to task_path(task), method: :delete,
                  class: "btn btn-soft btn-icon delete",
                  title: "Delete", data: { bs_toggle: "tooltip" },
                  form: { class: "d-inline", data: { turbo_confirm: "Are you sure?" } } do %>
              <i class="fa-solid fa-trash"></i>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state">
      <i class="fa-solid fa-clipboard-list d-block"></i>
      <p class="mb-0">No tasks yet. Add your first one!</p>
    </div>
  <% end %>
</div>
