<div class="app-shell">
  <div class="panel-card card">
    <%= form_with model: @task, url: task_path(@task), method: :patch do |f| %>
      <div class="panel-body">
        <h1 class="page-title h3 mb-4">Edit task</h1>

        <div class="mb-4">
          <%= f.label :title, class: "form-label" %>
          <%= f.text_field :title, class: "form-control form-control-lg" %>
        </div>

        <div class="mb-4">
          <%= f.label :details, class: "form-label" %>
          <%= f.text_area :details, rows: 5, class: "form-control" %>
        </div>

        <div>
          <label class="form-label d-block">Status</label>
          <%= f.check_box :completed, class: "btn-check", id: "task_completed" %>
          <label class="toggle-status btn" for="task_completed">
            <span class="when-off"><i class="fa-regular fa-clock me-2"></i>In progress</span>
            <span class="when-on"><i class="fa-solid fa-check me-2"></i>Completed</span>
            <small class="opacity-75">Click to toggle</small>
          </label>
        </div>
      </div>

      <div class="panel-footer d-flex justify-content-between">
        <%= link_to "Cancel", tasks_path, class: "btn btn-soft" %>
        <%= f.submit "Save changes", class: "btn btn-accent" %>
      </div>
    <% end %>
  </div>
</div>
